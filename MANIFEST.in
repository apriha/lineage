graft docs
graft src
graft tests

include CHANGELOG.md
include CONTRIBUTING.md
include CONTRIBUTORS.md
include LICENSE.txt
include LICENSES-3RD-PARTY.txt
include README.md

exclude .git*

# development tooling, not needed to build, install, or test from the sdist
prune .github
prune .vscode
exclude .pre-commit-config.yaml .python-version .readthedocs.yaml uv.lock

prune docs/images
prune docs/_build

global-exclude *.py[cod] __pycache__ *.so *.dylib
